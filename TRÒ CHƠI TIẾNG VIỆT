        function startSortingGame() {
            // Chọn ngẫu nhiên 10 từ đảm bảo đủ các nhóm
            state.sortItems = shuffleArray(SORTING_WORDS).slice(0, 10);
            state.sortIndex = 0;
            state.sortScore = 0;
            renderSortingGame();
        }

        function renderSortingGame() {
            const container = document.getElementById('app-container');

            // Màn hình hoàn thành Game 1
            if (state.sortIndex >= state.sortItems.length) {
                playVictorySound();
                triggerConfetti();
                addStars(state.sortScore * 2);
